<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Dance">
  <BehaviorTree ID="Dance">
    <Sequence>
      <RetryUntilSuccessful num_attempts="10">
        <GetPoseAction topic_name="tf" current_pose="{=}"/>
      </RetryUntilSuccessful>
      <GenerateDanceAction current_pose="{=}" goals="{=}"/>
      <LoopPose queue="{goals}" value="{pose}">
        <GoToPoseAction action_name="navigation_goal" target_pose="{pose}"/>
      </LoopPose>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="GetPoseAction"
            editable="true">
      <input_port name="topic_name"/>
      <output_port name="current_pose"/>
    </Action>
  </TreeNodesModel>

</root>
